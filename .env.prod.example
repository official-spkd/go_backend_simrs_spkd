# Copy to .env.prod and fill in. Never commit .env.prod.
#   docker compose -f docker-compose.prod.yml --env-file .env.prod up -d --build

# Base domain of the public subdomains api.<DOMAIN> and files.<DOMAIN> (served by your existing proxy).
DOMAIN=simrs-api

# Where the frontend is served (comma-separated, no wildcard). The browser calls the API from there.
# Empty = same-origin only, which blocks a frontend served from another address.
CORS_ALLOWED_ORIGINS=

# PostgreSQL (created on first start; changing it later does not change an existing database)
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=simrs
DB_TIMEZONE=Asia/Jakarta

# At least 32 characters. Generate with: openssl rand -hex 32
JWT_SECRET=
JWT_ACCESS_TTL_HOURS=8

# MinIO root credentials (secret: at least 8 characters). The API uses them too.
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=simrs
MINIO_REGION=us-east-1

# Host ports (127.0.0.1 only) that the existing reverse proxy forwards api.<DOMAIN> and files.<DOMAIN> to.
API_HOST_PORT=18080
MINIO_HOST_PORT=19000
