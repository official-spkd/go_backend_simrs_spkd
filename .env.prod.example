# Copy to .env.prod and fill in. Never commit .env.prod.
#   docker compose -f docker-compose.prod.yml --env-file .env.prod up -d --build

# Base domain: the stack serves api.<DOMAIN> and files.<DOMAIN>.
DOMAIN=simrs-api
# Let's Encrypt contact for certificate expiry notices.
ACME_EMAIL=admin@example.com

# Where the frontend is served (comma-separated, no wildcard). The browser calls the API from there.
CORS_ALLOWED_ORIGINS=

# PostgreSQL (created on first start; changing it later does not change an existing database)
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=simrs
DB_TIMEZONE=Asia/Jakarta

# At least 32 characters. Generate with: openssl rand -hex 32
JWT_SECRET=
JWT_ACCESS_TTL_HOURS=8

# MinIO root credentials (secret: at least 8 characters). The API uses them too.
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=simrs
MINIO_REGION=us-east-1
