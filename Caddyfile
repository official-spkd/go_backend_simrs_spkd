# Caddy for docker-compose.prod.yml. DOMAIN and ACME_EMAIL come from the container environment.
# Certificates are issued automatically for every site below. reverse_proxy keeps the original Host
# header, which MinIO needs: presigned URLs are signed for files.<DOMAIN>.
{
	email {$ACME_EMAIL}
}

api.{$DOMAIN} {
	encode zstd gzip
	reverse_proxy simrs-v2-api-prod:8080
}

files.{$DOMAIN} {
	# No compression: the objects are mostly images and PDFs, and ranged downloads must stay intact.
	reverse_proxy simrs-v2-api-prod-minio:9000
}
