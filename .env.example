APP_HOST=0.0.0.0
APP_PORT=8080

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=simrs
DB_SSLMODE=disable
DB_TIMEZONE=Asia/Jakarta

# Must be at least 32 characters. Generate with: openssl rand -hex 32
JWT_SECRET=
JWT_ACCESS_TTL_HOURS=8

# Comma-separated list of frontend origins allowed to call the API (no wildcard). Empty = same-origin only.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# File upload (MinIO). Leave MINIO_ENDPOINT empty to switch file upload off.
MINIO_ENDPOINT=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=simrs-files
MINIO_REGION=us-east-1
MINIO_USE_SSL=false
# Address browsers use to reach MinIO (presigned URLs are signed for it). Defaults to MINIO_ENDPOINT.
MINIO_PUBLIC_ENDPOINT=
MINIO_PUBLIC_USE_SSL=false

# Docker Compose only: host ports of the bundled MinIO.
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
