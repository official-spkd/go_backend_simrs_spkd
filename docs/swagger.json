    "definitions": {
        "auth.LoginRequest": {
            "type": "object",
            "required": [
                "identifier",
                "password"
            ],
            "properties": {
                "identifier": {
                    "description": "NIP or email",
                    "type": "string",
                    "example": "198001012010011001"
                },
                "password": {
                    "type": "string",
                    "example": "s3cretPass!"
                }
            }
        },
        "auth.LoginResponse": {
            "type": "object",
            "properties": {
                "access_token": {
                    "type": "string"
                },
                "expires_in": {
                    "description": "seconds",
                    "type": "integer",
                    "example": 28800
                },
                "token_type": {
                    "type": "string",
                    "example": "Bearer"
                },
                "user": {
                    "$ref": "#/definitions/auth.UserResponse"
                }
            }
        },
        "auth.RegisterRequest": {
            "type": "object",
            "required": [
                "email",
                "name",
                "nip",
                "password"
            ],
            "properties": {
                "email": {
                    "type": "string",
                    "maxLength": 150,
                    "example": "jane.doe@hospital.id"
                },
                "name": {
                    "type": "string",
                    "maxLength": 150,
                    "example": "Dr. Jane Doe"
                },
                "nip": {
                    "type": "string",
                    "maxLength": 30,
                    "example": "198001012010011001"
                },
                "password": {
                    "type": "string",
                    "maxLength": 72,
                    "minLength": 8,
                    "example": "s3cretPass!"
                },
                "role": {
                    "type": "string",
                    "example": "doctor"
                }
            }
        },
        "auth.UserResponse": {
            "type": "object",
            "properties": {
                "created_at": {
                    "type": "string"
                },
                "email": {
                    "type": "string",
                    "example": "jane.doe@hospital.id"
                },
                "id": {
                    "type": "string",
                    "example": "3f2b8c1e-5d4a-4e7b-9a1c-2b6f0d8e4a71"
                },
                "is_active": {
                    "type": "boolean",
                    "example": true
                },
                "name": {
                    "type": "string",
                    "example": "Dr. Jane Doe"
                },
                "nip": {
                    "type": "string",
                    "example": "198001012010011001"
                },
                "role": {
                    "type": "string",
                    "example": "doctor"
                }
            }
        },
        "roles.CreateRequest": {
            "type": "object",
            "required": [
                "display_name",
                "name"
            ],
            "properties": {
                "description": {
                    "type": "string",
                    "maxLength": 255,
                    "example": "Ward nurse"
                },
                "display_name": {
                    "type": "string",
                    "maxLength": 100,
                    "example": "Nurse"
                },
                "name": {
                    "type": "string",
                    "maxLength": 50,
                    "minLength": 2,
                    "example": "nurse"
                }
            }
        },
